:8080 {
	header Referrer-Policy "no-referrer"

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080
	}

	@assets path /assets /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
