# Copy this file to .env, fill the empty secrets, and keep .env private.
# Compose loads .env; the Go API reads the resulting process environment.

# Runtime mode and the browser origin used for setup, cookies, and Origin checks.
APP_ENV=development
APP_PUBLIC_URL=http://localhost:5173
# Address inside the API container; use 0.0.0.0:8080 for the default Compose mapping.
HTTP_ADDR=0.0.0.0:8080
# Total graceful-shutdown budget shared by the API and Compose stop grace period.
SHUTDOWN_TIMEOUT=30s
# Optional comma-separated CIDRs for the immediate reverse proxy. Only peers
# in these networks may supply X-Forwarded-For/X-Real-IP for history source IPs.
# TRUSTED_PROXY_CIDRS=172.20.0.0/16
# Host port published for the API; it is bound to loopback only.
API_PORT=8080
# Host port published for the Caddy admin origin; it is bound to loopback only.
ADMIN_PORT=5173
# Lifetime of the startup setup link.
SETUP_LINK_TTL=30m
# Go module download proxy used only while building the API image.
GOPROXY=https://proxy.golang.org,direct

# PostgreSQL client/service connection settings.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port published for PostgreSQL; it is bound to loopback only.
POSTGRES_HOST_PORT=5432
POSTGRES_DB=temvia
POSTGRES_USER=temvia
# Required PostgreSQL password; leave empty here and set it in the private .env.
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
# database/sql pool limits and connection lifetimes.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_TIME=5m
DB_CONN_MAX_LIFETIME=0s

# Server-side session lifetimes.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
# Maximum concurrent Argon2id operations in one API process.
PASSWORD_HASH_MAX_CONCURRENCY=2
# Login token-bucket capacities and one-token refill intervals. The global
# bucket is wider than the source bucket so shared-office users are not denied
# by the resource fallback before one abusive source is constrained.
LOGIN_RATE_LIMIT_GLOBAL_CAPACITY=60
LOGIN_RATE_LIMIT_GLOBAL_REFILL_INTERVAL=6s
LOGIN_RATE_LIMIT_EMAIL_CAPACITY=5
LOGIN_RATE_LIMIT_EMAIL_REFILL_INTERVAL=1m
# Source IP is intentionally broader than the email bucket so a shared office
# address can serve several normal users without disabling per-email checks.
LOGIN_RATE_LIMIT_IP_CAPACITY=30
LOGIN_RATE_LIMIT_IP_REFILL_INTERVAL=6s

# Anonymous entry-point protection. These buckets are independent by operation.
SETUP_RATE_LIMIT_IP_CAPACITY=10
SETUP_RATE_LIMIT_IP_REFILL_INTERVAL=1m
INVITATION_ACCEPT_RATE_LIMIT_IP_CAPACITY=30
INVITATION_ACCEPT_RATE_LIMIT_IP_REFILL_INTERVAL=1m
PASSWORD_RESET_COMPLETE_RATE_LIMIT_IP_CAPACITY=20
PASSWORD_RESET_COMPLETE_RATE_LIMIT_IP_REFILL_INTERVAL=1m

# Password recovery. Generate the token key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# It is required, must be exactly 32 random bytes encoded as unpadded Base64URL,
# and should be kept stable across restarts. Rotate it deliberately: pending
# reset messages derived with the old key are discarded and users request a new
# link.
PASSWORD_RESET_TOKEN_KEY=
PASSWORD_RESET_LINK_TTL=30m
# Invitation links use a separate signing key. Generate it with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
INVITATION_TOKEN_KEY=
INVITATION_LINK_TTL=72h
PASSWORD_RESET_MIN_RESPONSE_TIME=500ms
PASSWORD_RESET_RATE_LIMIT_GLOBAL_CAPACITY=10
PASSWORD_RESET_RATE_LIMIT_GLOBAL_REFILL_INTERVAL=6s
PASSWORD_RESET_RATE_LIMIT_EMAIL_CAPACITY=3
PASSWORD_RESET_RATE_LIMIT_EMAIL_REFILL_INTERVAL=20m
PASSWORD_RESET_RATE_LIMIT_IP_CAPACITY=30
PASSWORD_RESET_RATE_LIMIT_IP_REFILL_INTERVAL=6s

# Authenticated mail-trigger limits. Invitation create/resend share one
# recipient policy; test mail has a separate total, actor, and recipient policy.
INVITATION_RATE_LIMIT_ACTOR_CAPACITY=20
INVITATION_RATE_LIMIT_ACTOR_REFILL_INTERVAL=1m
INVITATION_RATE_LIMIT_RECIPIENT_CAPACITY=3
INVITATION_RATE_LIMIT_RECIPIENT_REFILL_INTERVAL=20m
TEST_EMAIL_RATE_LIMIT_GLOBAL_CAPACITY=20
TEST_EMAIL_RATE_LIMIT_GLOBAL_REFILL_INTERVAL=1h
TEST_EMAIL_RATE_LIMIT_ACTOR_CAPACITY=5
TEST_EMAIL_RATE_LIMIT_ACTOR_REFILL_INTERVAL=1h
TEST_EMAIL_RATE_LIMIT_RECIPIENT_CAPACITY=3
TEST_EMAIL_RATE_LIMIT_RECIPIENT_REFILL_INTERVAL=20m

# The API stores SMTP credentials encrypted in PostgreSQL. Generate this key
# with `node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"`, keep it stable across restarts, and back it
# up separately from the database. SMTP host, security, sender, and the default
# mail language are configured in System settings after startup.
EMAIL_SETTINGS_ENCRYPTION_KEY=
# SMTP delivery timeout and durable outbox retry settings.
SMTP_DELIVERY_TIMEOUT=10s
MAIL_DISPATCH_INTERVAL=1s
MAIL_OUTBOX_LEASE_TTL=30s
MAIL_RETRY_INITIAL_INTERVAL=5s
MAIL_RETRY_MAX_INTERVAL=10m
MAIL_NOTIFICATION_TTL=24h
# Mailpit UI is loopback-only; SMTP remains private to the Compose network.
MAILPIT_UI_PORT=8025
